# Copiar a application-dev.properties (gitignoreado) y completar con los
# valores reales. Con el perfil "dev" activo (Run Configuration de IntelliJ
# -> Active profiles: dev) Spring lo toma solo, sin tocar Environment variables.
#
# Estas claves llenan los mismos placeholders ${DB_HOST:...} etc. que usa
# application.yml — no hace falta tocar ese archivo.

DB_HOST=187.77.60.183
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=

# Si lo dejás vacío, cae al mismo default que usa SGO en dev (ver
# application.yml) — probar así primero, puede que en el VPS nunca lo hayan
# cambiado.
JWT_SECRET=

# Por default SGO_GATEWAY_URL apunta a prod (https://buildrr.cloud, base
# sgo_auth). Para probar contra sgo_auth_test hay que levantar el
# auth-service de SGO local con perfil dev (sistema-gestion-obras/backend1.0/auth-service,
# puerto 8089) y descomentar esta línea:
# SGO_GATEWAY_URL=http://localhost:8089
