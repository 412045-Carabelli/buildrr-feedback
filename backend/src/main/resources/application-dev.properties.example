# Copiar a application-dev.properties (gitignoreado) y completar con los
# valores reales. Con el perfil "dev" activo (Run Configuration de IntelliJ
# -> Active profiles: dev) Spring lo toma solo, sin tocar Environment variables.
#
# Estas claves llenan los mismos placeholders ${DB_HOST:...} etc. que usa
# application.yml — no hace falta tocar ese archivo.

DB_HOST=187.77.60.183
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=

# No hace falta JWT_SECRET ni URL de auth acá — este backend ya no valida
# JWT ni loguea contra nada. Confía en los headers de identidad que inyecta
# el api-gateway compartido de Buildr (ver GatewayAuthFilter y
# docs/00-arquitectura.md). Para probar localmente hace falta levantar
# buildr-platform (ver su README) y que el gateway rutee acá.
