# SQL Server: misma instancia que usa el Sistema de Gestion de Obras, base separada.
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=buildr_supp
DB_USER=sa
DB_PASSWORD=

# Mismo secret HS256 que usa auth-service de SGO — única fuente de identidad
# del ecosistema (Pablo y la dueña de FrezCo son cuentas de sgo_auth). En dev,
# si se deja vacío, cae al mismo default que usa SGO en application-dev.properties.
# En prod hay que poner el valor REAL configurado en el VPS de SGO (no está
# en ningún repo).
JWT_SECRET=

# A qué ambiente de SGO le pega /auth/login: prod (default, sgo_auth) o un
# auth-service local con perfil dev (sgo_auth_test, puerto 8089) para probar
# sin tocar producción.
SGO_GATEWAY_URL=https://buildrr.cloud

# MinIO: mismo endpoint que usa el stack SGO, credenciales propias o compartidas.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

BACKEND_PORT=8091
FRONTEND_PORT=4301
