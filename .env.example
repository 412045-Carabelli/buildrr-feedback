# SQL Server: misma instancia que usa el Sistema de Gestion de Obras, base separada.
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=buildrr_feedback
DB_USER=sa
DB_PASSWORD=

# Mismo secret HS256 que usa auth-service de SGO. Sin esto los tokens no validan.
JWT_SECRET=

# MinIO: mismo endpoint que usa el stack SGO, credenciales propias o compartidas.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

BACKEND_PORT=8091
FRONTEND_PORT=4301
