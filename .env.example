# SQL Server: misma instancia que usa el Sistema de Gestion de Obras, base separada.
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=buildr_supp
DB_USER=sa
DB_PASSWORD=

# Sin JWT_SECRET ni URL de auth acá — este backend no valida JWT ni loguea:
# confía en los headers de identidad que inyecta el api-gateway compartido de
# Buildr (ver GatewayAuthFilter y docs/00-arquitectura.md).

# MinIO: mismo endpoint que usa el stack SGO, credenciales propias o compartidas.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

BACKEND_PORT=8091
FRONTEND_PORT=4301
