# SQL Server: misma instancia que usa el Sistema de Gestion de Obras, base separada.
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=buildr_supp
DB_USER=sa
DB_PASSWORD=

# Mismo secret HS256 que usa auth-service de SGO. En dev, si se deja vacío, cae
# al mismo default que usa SGO en application-dev.properties. En prod hay que
# poner el valor REAL configurado en el VPS de SGO (no está en ningún repo).
JWT_SECRET=

# Secret propio de buildrr-feedback (SOLO para tokens de cuentas FrezCo). Tiene
# que ser distinto de JWT_SECRET. Generar uno propio para prod.
JWT_OWN_SECRET=

# Dominio público real de SGO — ahí vive /auth/login (el mismo que usa Pablo
# para entrar día a día). Default ya apunta al real.
SGO_GATEWAY_URL=https://buildrr.cloud

# Usuario de FrezCo, SOLO para que el Mediator sepa rutear el login para ese
# lado — la contraseña nunca se guarda acá, se valida contra el login real de
# FrezCo (FREZCO_LOGIN_URL). Default ya apunta al real.
FREZCO_APP_USER=
FREZCO_LOGIN_URL=https://frezco.buildrr.cloud

# MinIO: mismo endpoint que usa el stack SGO, credenciales propias o compartidas.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

BACKEND_PORT=8091
FRONTEND_PORT=4301
